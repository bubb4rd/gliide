<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The feed's pull while gliide is closed (background.rs): bundled at Contents/Library/LaunchAgents and registered
     with SMAppService from Settings → Feed. launchd runs the app's own executable headless every 3 hours. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.bubb4rd.gliide.feed</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/gliide</string>
	<key>ProgramArguments</key>
	<array>
		<string>gliide</string>
		<string>--pull-feed</string>
	</array>
	<key>StartInterval</key>
	<integer>10800</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
