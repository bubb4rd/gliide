{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "company",
    "short_role",
    "location",
    "seniority",
    "skills",
    "title_terms",
    "years_min",
    "degree",
    "certifications",
    "knockouts"
  ],
  "properties": {
    "role": { "type": "string", "minLength": 1, "maxLength": 120 },
    "company": { "type": "string", "maxLength": 80 },
    "short_role": { "type": "string", "pattern": "^[a-z0-9_]{1,24}$" },
    "location": { "type": "string", "maxLength": 80 },
    "seniority": { "enum": ["intern", "entry", "mid", "senior", "lead"] },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "aliases", "kind", "priority", "required"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 60 },
          "aliases": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 60 }
          },
          "kind": { "enum": ["hard", "tool", "domain", "soft"] },
          "priority": { "enum": [1, 2, 3] },
          "required": { "type": "boolean" }
        }
      }
    },
    "title_terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "years_min": { "type": ["integer", "null"], "minimum": 0, "maximum": 30 },
    "degree": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["level", "fields"],
      "properties": {
        "level": { "enum": ["associate", "bachelor", "master", "phd"] },
        "fields": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    },
    "certifications": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "knockouts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "enum": ["clearance", "authorization", "onsite", "other"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
