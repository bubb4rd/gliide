{
  "type": "object",
  "additionalProperties": false,
  "required": ["focus", "questions", "gaps", "ask_them"],
  "properties": {
    "focus": { "type": "string", "minLength": 1, "maxLength": 240 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "text", "why", "lines", "story"],
        "properties": {
          "group": { "enum": ["resume", "skills", "behavioral", "logistics"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 },
          "why": { "type": "string", "maxLength": 90 },
          "lines": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 80 } },
          "story": { "type": ["string", "null"], "maxLength": 80 }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "required", "answer", "lines"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 120 },
          "required": { "type": "boolean" },
          "answer": { "type": "string", "minLength": 1, "maxLength": 300 },
          "lines": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 80 } }
        }
      }
    },
    "ask_them": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
