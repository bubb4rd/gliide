{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "headline", "evidence", "keywords", "bullets", "skills", "bank", "order", "summary", "gaps"],
  "properties": {
    "verdict": { "enum": ["apply", "tailor", "stretch", "skip"] },
    "headline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "have", "ids"],
        "properties": {
          "skill": { "type": "string", "minLength": 1, "maxLength": 60 },
          "have": { "enum": ["yes", "add", "no"] },
          "ids": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
        }
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "line", "term", "from", "skill", "priority", "why"],
        "properties": {
          "op": { "enum": ["add", "edit", "drop"] },
          "line": { "type": "string", "minLength": 1, "maxLength": 60 },
          "term": { "type": "string", "minLength": 1, "maxLength": 60 },
          "from": { "type": "string", "maxLength": 60 },
          "skill": { "type": "string", "maxLength": 60 },
          "priority": { "enum": [1, 2, 3] },
          "why": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "bullets": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "id", "before", "after", "hits", "sources", "variant", "priority", "why"],
        "properties": {
          "op": { "enum": ["rewrite", "add", "cut"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 60 },
          "before": { "type": "string", "maxLength": 400 },
          "after": { "type": "string", "maxLength": 300 },
          "hits": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "sources": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "variant": { "type": ["integer", "null"], "minimum": 0 },
          "priority": { "enum": [1, 2, 3] },
          "why": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "group", "item", "to", "skill", "priority", "why"],
        "properties": {
          "op": { "enum": ["add", "remove", "rename", "move"] },
          "group": { "type": "string", "minLength": 1, "maxLength": 60 },
          "item": { "type": "string", "minLength": 1, "maxLength": 60 },
          "to": { "type": "string", "maxLength": 60 },
          "skill": { "type": "string", "maxLength": 60 },
          "priority": { "enum": [1, 2, 3] },
          "why": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "bank": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "entry", "bullets", "replaces", "skills", "why"],
        "properties": {
          "op": { "enum": ["include", "swap"] },
          "entry": { "type": "string", "minLength": 1, "maxLength": 60 },
          "bullets": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "replaces": { "type": "string", "maxLength": 60 },
          "skills": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "why": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "order": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "entries"],
        "properties": {
          "section": { "type": "string", "minLength": 1, "maxLength": 60 },
          "entries": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
        }
      }
    },
    "summary": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
    "gaps": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap", "fix", "skill"],
        "properties": {
          "gap": { "type": "string", "minLength": 1, "maxLength": 80 },
          "fix": { "type": "string", "minLength": 1, "maxLength": 160 },
          "skill": { "type": "string", "maxLength": 60 }
        }
      }
    }
  }
}
