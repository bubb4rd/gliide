{
  "type": "object",
  "additionalProperties": false,
  "required": ["digs", "prep_notes"],
  "properties": {
    "digs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stuck_on", "entry", "questions"],
        "properties": {
          "stuck_on": { "type": "string", "minLength": 1, "maxLength": 160 },
          "entry": { "type": "string", "minLength": 1, "maxLength": 80 },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["about", "text", "why"],
              "properties": {
                "about": { "type": "string", "minLength": 1, "maxLength": 80 },
                "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                "why": { "type": "string", "maxLength": 80 }
              }
            }
          }
        }
      }
    },
    "prep_notes": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
