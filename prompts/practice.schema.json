{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lines",
    "situation",
    "task",
    "action",
    "result",
    "star_note",
    "mismatches",
    "new_claims",
    "tighter",
    "follow_up"
  ],
  "properties": {
    "lines": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 80 } },
    "situation": { "enum": ["yes", "thin", "no"] },
    "task": { "enum": ["yes", "thin", "no"] },
    "action": { "enum": ["yes", "thin", "no"] },
    "result": { "enum": ["yes", "thin", "no"] },
    "star_note": { "type": ["string", "null"], "maxLength": 200 },
    "mismatches": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["said", "resume", "line"],
        "properties": {
          "said": { "type": "string", "minLength": 1, "maxLength": 160 },
          "resume": { "type": "string", "minLength": 1, "maxLength": 160 },
          "line": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "new_claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "entry"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 240 },
          "entry": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "tighter": { "type": ["string", "null"], "maxLength": 900 },
    "follow_up": { "type": ["string", "null"], "maxLength": 300 }
  }
}
