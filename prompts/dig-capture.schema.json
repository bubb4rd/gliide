{
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "facts", "ops", "follow_ups", "skipped"],
  "properties": {
    "reply": { "type": "string", "minLength": 1, "maxLength": 300 },
    "facts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "skills", "from"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 240 },
          "skills": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 60 } },
          "from": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 20 } }
        }
      }
    },
    "ops": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "bullet", "text", "skills", "story", "why"],
        "properties": {
          "op": { "enum": ["add_variant", "add_bullet", "tag_skills", "add_story"] },
          "bullet": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 240 },
          "skills": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 60 } },
          "story": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["title", "entry", "bullets", "facts", "situation", "task", "action", "result", "skills", "themes"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 90 },
              "entry": { "type": ["string", "null"], "maxLength": 80 },
              "bullets": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 80 } },
              "facts": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 80 } },
              "situation": { "type": "string", "maxLength": 400 },
              "task": { "type": "string", "maxLength": 400 },
              "action": { "type": "string", "maxLength": 600 },
              "result": { "type": "string", "maxLength": 400 },
              "skills": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 60 } },
              "themes": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "enum": [
                    "conflict",
                    "failure",
                    "leadership",
                    "ambiguity",
                    "deadline",
                    "impact",
                    "learning",
                    "teamwork",
                    "initiative"
                  ]
                }
              }
            }
          },
          "why": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "follow_ups": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["about", "text", "why"],
        "properties": {
          "about": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "why": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "skipped": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "why"],
        "properties": {
          "what": { "type": "string", "minLength": 1, "maxLength": 80 },
          "why": { "type": "string", "minLength": 1, "maxLength": 140 }
        }
      }
    }
  }
}
